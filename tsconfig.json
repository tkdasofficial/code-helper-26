{
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "supabase/config.ts",
    "supabase/config/**/*.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "preserve",
    "module": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@tanstack/react-router": ["./src/lib/compat/react-router.tsx"],
      "@tanstack/react-start": ["./src/lib/compat/react-start.ts"],
      "@tanstack/react-start/server": ["./src/lib/compat/react-start-server.ts"],
      "@tanstack/react-start/client": ["./src/lib/compat/react-start-client.ts"],
      "@hyper-vision/web-sdk": ["./src/lib/web-sdk/index.ts"],
      "@hyper-vision/web-sdk/*": ["./src/lib/web-sdk/*"],
      "config": ["./supabase/config/config.ts"],
      "@/config": ["./src/config.ts"],
      "supabase-config": ["./supabase/config/config.ts"]
    }
  },
  "exclude": ["node_modules"]
}
